int32 main() {
    valor=int32(0);
    i = float(0.0);
    pos=int32(0);
    aux=int32(0);
    while(i <= 100) {
        aux = int32(Sqrt(i)*casas_decimais);
        valor=int32(values[pos]*casas_decimais);
        if (abs32(aux-valor)>10) {
                if(i!=0){
                    return pos;
                }else{
                    return -1;
                }
        }
        i+=0.5;
        pos++;
    }
    return 0;
}