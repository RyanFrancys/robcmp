int16 main() {
    i = float(-2.0);
    pos=int32(0);
    value=int32(0);
    result=int32(0);
    while(i <= 2.0) {
        result = int32(Exp(i)*casas_decimais);
        value=int32(values[pos]*casas_decimais);
        if (abs32(result-value)>10) {
                if(i!=0){
                    return int16(pos);
                }else{
                    return -1;
                }
        }
        i+=0.01;
        pos++;
    }
    return 0;
}