int16 main() {
    valor=int32(0);
    i = float(0.0);
    pos=int16(0);
    aux=int32(0);
    while(i <= 240.0) {
        aux = int32(ln(i)*casas_decimais);
        valor=int32(values[pos]*casas_decimais);
        if (abs32(aux-valor)>10) {
                if(i!=0){
                    return int16(i);
                }else{
                    return -1;
                }
        }
        i=i+0.5;
        pos++;
    }
    return 0;
}