int16 main() {
    i = float(0.0);
    pos=int32(0);
    value=int64(0);
    result=int64(0);
    while(i <= 3.0) {
        result = int64(Exp(i)*casas_decimais);
        value=int64(values[pos]*casas_decimais);
        if (abs64(result-value)>10) {
                if(i!=0){
                    return int16(1);
                }else{
                    return -1;
                }
        }
        i+=0.01;
        pos++;
    }
    return 0;
}