int16 main() {
    degress=float(0.0);
    value=int32(0);
    result=int32(0);
    i = int32(0);
    while(degress <= 200.0) {
    value=int32(values[i]*precision_digits);
    result=int32(Tan((float(degress) * FM_PI) / 180.0,20)*precision_digits);
    if (abs32(value-result)>10) {
        if(i!=0){
            return int16(i);
        }else{
            return 1;
        }
    }
    i=i+1;
    degress+=0.5;
    }
    return 0;
}
