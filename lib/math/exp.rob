use math.fconsts;

float Exp( float x )
{

  a = {
    1.648721270700128, 
    1.284025416687742, 
    1.133148453066826, 
    1.064494458917859, 
    1.031743407499103, 
    1.015747708586686, 
    1.007843097206488, 
    1.003913889338348, 
    1.001955033591003, 
    1.000977039492417, 
    1.000488400478694, 
    1.000244170429748, 
    1.000122077763384, 
    1.000061037018933, 
    1.000030518043791, 
    1.0000152589054785, 
    1.0000076294236351, 
    1.0000038147045416, 
    1.0000019073504518, 
    1.0000009536747712, 
    1.0000004768372719, 
    1.0000002384186075, 
    1.0000001192092967, 
    1.0000000596046466};
  fx = float(1.0);
  i = uint8(0);
  poweroftwo = float(0.5);
  x_int = int32(0);
  y = float(0.0);
  z = float(0.0);
  w = {0.0:25};
  x_int  =  int32( x );
/*
  Determine the weights.
*/

  z  =  float(x-x_int);
  i  =  0;
  while(i < 24)
  {
    if ( poweroftwo < z )
    {
      w[i]  =  1.0;
      z  =  z - poweroftwo;
    }
    poweroftwo  =  poweroftwo / 2.0;
    i++;
  }
/*
  Calculate products.
*/
  i  =  0;
  while(i < 24)
  {
    if ( 0.0 < w[i] )
    {
      fx  =  fx * a[i];
    }
    i++;
  }
/*
  Perform residual multiplication.
*/
  fx  =  fx * ( 1.0 + z* ( 1.0 + z / 2.0* ( 1.0 + z / 3.0* ( 1.0 + z / 4.0 ))));
/*
  Account for factor EXP(X_INT).
*/
  i  =  1;
  if ( x_int < 0 )
  {
    while( i < =  -x_int )
    {
      fx  =  fx / FM_E;
      i++;
    }
  }
  else
  {
    while (i < =  x_int )
    {
      fx  =  fx * FM_E;
      i++;
    }
  }
  return fx;

}